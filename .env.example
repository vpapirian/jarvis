# Copy this file to ".env" (same folder) and fill in your real values.
# Never commit or share your real .env -- it has your API keys/secrets in it.

# --- Claude (the "brain") ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5

# --- Wake word / behavior ---
WAKE_WORD=jarvis
ASSISTANT_NAME=Jarvis
FOLLOW_UP_WINDOW_SECONDS=12

# --- Local speech-to-text (faster-whisper) ---
# tiny/base/small/medium/large-v3 -- bigger = more accurate but slower.
# "small" is a good balance on a normal CPU.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Leave blank to use your system's default microphone. To list devices,
# run: python -c "import speech_recognition as sr; print(sr.Microphone.list_microphone_names())"
INPUT_DEVICE_INDEX=

# --- Text-to-speech ---
TTS_RATE=185
# Optional: pick a specific installed Windows voice, e.g. "Zira" or "David".
# Leave blank for the system default.
TTS_VOICE=

# --- Spotify (see README.md "Spotify setup") ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# --- Safety ---
# Ask for spoken confirmation before running commands that look destructive
# (deleting files, shutting down, killing processes, etc).
CONFIRM_DANGEROUS_COMMANDS=true
# Ask for confirmation before EVERY shell command, not just risky ones.
CONFIRM_ALL_COMMANDS=false
# Restrict read_file/write_file/list_dir to this folder. Leave blank to
# allow Jarvis to read/write anywhere on disk.
FILES_ROOT=
